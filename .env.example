# ==============================================================
# Ritual Skill Hub v2 — Environment template
# Copy to .env and fill values. NEVER commit .env.
# ==============================================================

# --- Chain ---
RITUAL_RPC_URL=https://rpc.ritualfoundation.org
RITUAL_CHAIN_ID=1979
RITUAL_EXPLORER_URL=https://explorer.ritualfoundation.org

# --- Deployer wallet (Hardhat scripts) ---
# Testnet key only. Never use a mainnet key here.
DEPLOYER_PRIVATE_KEY=

# --- Deployed contract addresses (filled after Phase 4 deploy) ---
SKILL_REGISTRY_ADDRESS=
SKILL_EXECUTION_ADDRESS=

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_RITUAL_RPC_URL=https://rpc.ritualfoundation.org
NEXT_PUBLIC_RITUAL_CHAIN_ID=1979
NEXT_PUBLIC_RITUAL_EXPLORER_URL=https://explorer.ritualfoundation.org
NEXT_PUBLIC_SKILL_REGISTRY_ADDRESS=
NEXT_PUBLIC_SKILL_EXECUTION_ADDRESS=

# --- IPFS (skill metadata) ---
# web3.storage token, or leave blank to use dev fallback
NEXT_PUBLIC_WEB3_STORAGE_TOKEN=
