# Termux/proot (android arm64): no Android NDK, so native addons can't compile.
# bufferutil & utf-8-validate arrive as HARD deps via @metamask/sdk-communication-layer
# (not optional deps of `ws` as previously assumed), so `omit=optional` never applied to
# them and `overrides: false` did not prune them either. npm 11 still placed bufferutil
# and ran its node-gyp-build install step, which invoked node-gyp and failed (no NDK).
#
# Fix: skip install scripts entirely. This stops node-gyp from ever running for these
# native addons. `ws` requires them inside a try/catch and falls back to pure JS at
# runtime when the native binding is absent, so functionality is unaffected.
#
# Caveat: ignore-scripts is global. The only other build-sensitive dep is `next`, whose
# SWC binary is fetched as a prebuilt (not gyp-compiled), so this is safe here. If a
# future build complains about a missing SWC binary, run `npm rebuild next` rather than
# reverting this setting.
ignore-scripts=true
omit=optional
